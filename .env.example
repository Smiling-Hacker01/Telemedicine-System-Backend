# ==============================================================================
# AMRUTAM TELEMEDICINE BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://amrutam_user:amrutam_secure_pass@localhost:5434/amrutam_telemedicine?schema=public&connection_limit=50&pool_timeout=20
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=50

# Cache & Distributed Locking (Redis 7)
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=amrutam:
CACHE_DEFAULT_TTL_SEC=300

# Authentication & Tokens
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PASSWORD_SALT_ROUNDS=12

# Multi-Factor Authentication (MFA / TOTP)
MFA_APP_NAME="Amrutam Telemedicine"
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Data Encryption at Rest (AES-256-GCM for Prescriptions & PHI)
# 64 hex characters = 32 bytes key
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting
RATE_LIMIT_MAX_PER_MINUTE=120
AUTH_RATE_LIMIT_MAX_PER_MINUTE=10

# Payment Gateway Simulation (Stripe / Razorpay mock)
PAYMENT_WEBHOOK_SECRET=whsec_amrutam_test_secret_for_signature_verification_32ch
PAYMENT_PROVIDER=mock

# CORS Allowed Origins
CORS_ORIGIN=*
